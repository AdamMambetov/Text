filters:
  and:
    - file.inFolder("Text/Music/Tracks")
views:
  - type: table
    name: Created Group
    groupBy:
      property: created
      direction: ASC
    order:
      - created
      - file.name
    sort: []
    columnSize:
      note.created: 178
  - type: table
    name: Year Group
    groupBy:
      property: Year
      direction: ASC
    order:
      - Year
      - file.name
    columnSize:
      note.Year: 93
  - type: table
    name: invalid
    filters:
      or:
        - valid == null
        - valid == false
    order:
      - valid
      - file.name
    sort:
      - property: created
        direction: ASC
    columnSize:
      file.name: 983
