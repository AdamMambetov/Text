    {
      "id": "a7a3c42f-ad78-421c-8f7f-30cf803ccaef",
      "name": "button",
      "type": "Capture",
      "command": false,
      "appendLink": false,
      "captureTo": "",
      "captureToActiveFile": true,
      "createFileIfItDoesntExist": {
        "enabled": false,
        "createWithTemplate": false,
        "template": ""
      },
      "format": {
        "enabled": true,
        "format": "```js quickadd\nfunction createBtn(name, id, link) {\n    let result = \"\"\n    result += \"\\`\\`\\`button\\n\"\n    result += `name ${name}\\n`\n    result += \"type link\\n\"\n    result += `action ${link}\\n`\n    result += `class button-${id}\\n`\n    result += \"hidden true\\n\"\n    result += \"\\`\\`\\`\\n\"\n    result += `^button-${id}\\n`\n    return result\n}\n\nconst linkInfo = {\n\tlinks: [\"shikimori.one\", \"tvtime.com\", \"world-art.ru\", \"onikes.ru\", \"yo8z6gv.github.io\", \"animefillerlist.com\", \"mangalib.me\", \"ranobelib.me\", \"anilib.me\", \"senkuro.com\", \"reyohoho.github.io/reyohoho\", \"freetp.org\", \"store.steampowered.com\", \"store.epicgames.com\", \"gog.com\", \"author.today\"],\n\tnames: [\"shikimori\", \"tvTime\", \"worldArt\", \"onikes\", \"kesidatokioVods\", \"animeFillerList\", \"mangalib\", \"ranobelib\", \"animelib\", \"senkuro\", \"reyohoho\", \"freetp\", \"steam\", \"epicGames\", \"gog\", \"authorToday\"],\n\tbuttons: [\"Shikimori\", \"TV Time\", \"World Art\", \"ONIKES\", \"KESIDATOKIO VOD'S\", \"Anime Filler List\", \"MangaLib\", \"RanobeLib\", \"AnimeLib\", \"Senkuro\", \"ReYohoho\", \"FreeTP\", \"Steam\", \"Epic Games\", \"GOG\", \"AuthorToday\"],\n}\n\nconst modalForm = app.plugins.plugins.modalforms.api;\nconst result = await modalForm.openForm('button-form');\nlet links = result.asString(\"{{Links}}\")\nlet returnValue = \"\"\n\nif (links !== \"{{Links}}\") {\n\tlinks = links.split(\",\")\n\tfor (let i = 0; i < links.length; i++) {\n\t\tlet index = linkInfo.links.findIndex(link => links[i].includes(link))\n\t\tif (index == -1)\n\t\t\treturnValue += createBtn(`Button ${i}`, `${i}`, links[i])\n\t\telse\n\t\t\treturnValue += createBtn(linkInfo.buttons[index], linkInfo.names[index], links[i])\n\t}\n}\n\nif (links !== \"{{Links}}\") {\n\tfor (let i = 0; i < links.length; i++) {\n\t\tlet index = linkInfo.links.findIndex(link => links[i].includes(link))\n\t\tlet btnId = \"\"\n\t\tif (index == -1)\n\t\t\tbtnId = `${i}`\n\t\telse\n\t\t\tbtnId = linkInfo.names[index]\n\t\t\n\t\tif (i % 2 == 0)\n\t\t\treturnValue += `\\n\\n\\`button-${btnId}\\``\n\t\telse\n\t\t\treturnValue += ` \\`button-${btnId}\\``\n\t}\n}\n\nreturn returnValue\n```"
      },
